APP_NAME=CARROT
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=carrot
DB_USERNAME=carrot
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The departments a tool may belong to, comma separated. Leave blank and the
# department field falls back to free text.
CATALOG_DEPARTMENTS=

# Who may register a tool: `all`, `admin` (only the development team, who file
# and approve their own submissions) or `none` (nobody - the submission and
# approval screens are gone). Pick `none` at deploy time, not while requests
# are in flight; `all` and `admin` are safe to change whenever.
CATALOG_SUBMISSIONS=all
# The request queue at /tools/requests, where people ask the development
# team for a tool that does not exist yet.
CATALOG_REQUESTS=true

# owner/name of a private repository every published tool is mirrored to, one
# commit per change. Off unless both it and the token are set. The token is a
# fine-grained one with Contents: read and write. The branch has to exist.
GITHUB_REPOSITORY=
GITHUB_TOKEN=
GITHUB_BRANCH=main

# Sandbox: `none` on the web host (queues runs only), `docker` on the runner
# host (rootless dockerd), `bubblewrap` for local development without Docker.
# Script tools stay queued until a driver other than `none` works the
# `sandbox` queue.
SANDBOX_DRIVER=none
SANDBOX_TIMEOUT_MAX=120
SANDBOX_MEMORY_MAX=512
SANDBOX_OUTPUT_BYTES=262144
SANDBOX_RATE_LIMIT=5
SANDBOX_RUN_RETENTION_DAYS=30

# Images the docker driver runs, and what people are told they write for.
SANDBOX_IMAGE_PHP=carrot-sandbox-php:8.4
SANDBOX_IMAGE_SHELL=carrot-sandbox-shell:3.20
SANDBOX_RUNTIME_PHP="PHP 8.4 (php:8.4-cli-alpine)"
SANDBOX_RUNTIME_SHELL="Shell - BusyBox sh + coreutils + jq (alpine:3.20)"

# Docker driver only. The network an `internet` tool is attached to - point it
# at a bridge whose egress you control. Everything else gets --network none.
SANDBOX_INTERNET_NETWORK=bridge
# Refuse to run against a root dockerd. Only turn this off on a dev box.
SANDBOX_REQUIRE_ROOTLESS=true

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
